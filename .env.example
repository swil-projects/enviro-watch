# Copy to .env and fill in. Never commit .env.
# No database is used: data is fetched from the provider APIs on demand and merged in memory.

# ---------------------------------------------------------------- Application
NEXT_PUBLIC_APP_NAME="Environmental Monitoring Platform"
# Default display time zone (observations are always handled in UTC internally)
APP_TIMEZONE=America/Jamaica
# true = explicitly-labelled synthetic demo data, no provider calls. Never used as a fallback.
DEMO_MODE=false
# How long a provider snapshot is reused before the APIs are called again (30–3600 s).
# All viewers share one cached snapshot, so this bounds the API call rate.
REFRESH_INTERVAL_SECONDS=120
# Minutes without a new observation before a station is classed as stale (×6 = offline)
STALE_AFTER_MINUTES=60
# Upper bound on a single historical query range (days)
MAX_HISTORY_DAYS=90

# ---------------------------------------------------------------- Obscape
# www.obscape.com redirects to obscape.com; using the apex host avoids the redirect.
OBSCAPE_BASE_URL=https://obscape.com/portal/api/v3/api
OBSCAPE_USERNAME=your_obscape_username
OBSCAPE_API_KEY=YOUR_OBSCAPE_API_KEY
# Optional comma-separated project names/ids to include (applied to the API response)
OBSCAPE_PROJECTS=

# ---------------------------------------------------------------- LI-COR Cloud
LICOR_BASE_URL=https://api.licor.cloud
LICOR_API_TOKEN=YOUR_LICOR_API_TOKEN
# Comma-separated logger serial numbers
LICOR_LOGGER_SERIALS=20029439

# ---------------------------------------------------------------- Ecowitt
ECOWITT_BASE_URL=https://api.ecowitt.net
ECOWITT_APPLICATION_KEY=YOUR_APPLICATION_KEY
ECOWITT_API_KEY=YOUR_ECOWITT_API_KEY
# Comma-separated MAC addresses (or 15-digit IMEIs). Devices on the account are also auto-discovered.
ECOWITT_DEVICE_MACS=9C:13:9E:67:2F:4C

# ---------------------------------------------------------------- Authentication
# All three are required to enable sign-in. Without them: open access in development,
# and every page/API is refused in production.
# Generate a secret with: openssl rand -base64 48
AUTH_SECRET=YOUR_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD
# Set to true to skip login entirely (local evaluation only — never on a public server)
AUTH_DISABLED=false
